<Window x:Class="EditExcel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EditExcel — Excel + GitHub" Width="830" Height="660" MinWidth="700" MinHeight="590" FlowDirection="RightToLeft" Background="#F4F7FA" FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,10"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Excel على جهازك. نسختك على GitHub." FontSize="25" FontWeight="Bold" Foreground="#176B49"/><TextBlock Margin="0,8,0,20" Text="عدّل في Excel واضغط Ctrl + S. اترك هذا البرنامج مفتوحًا حتى تظهر رسالة نجاح الرفع." TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="1" x:Name="ConnectionPanel">
   <TextBlock Text="رابط ملف Excel على GitHub"/><TextBox x:Name="UrlBox" FlowDirection="LeftToRight" Text="https://github.com/waleedzidan2020/editexcel/blob/main/data/schools.xlsx"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,0,0"><TextBlock Text="الفرع (Branch)"/><TextBox x:Name="BranchBox" Text="main" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="GitHub Token — صلاحية Contents: Read and write"/><PasswordBox x:Name="TokenBox" Padding="8" Margin="0,5,0,10" FlowDirection="LeftToRight"/></StackPanel></Grid>
   <TextBlock Text="التوكن يُستخدم خلال تشغيل البرنامج فقط ولا يُحفظ على القرص." Foreground="#52616B"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <WrapPanel><Button x:Name="ConnectButton" Content="اتصال وفتح Excel" Click="Connect_Click" Background="#176B49" Foreground="White"/><Button x:Name="SyncButton" Content="مزامنة الآن" Click="Sync_Click" IsEnabled="False"/><Button x:Name="StopButton" Content="إيقاف المزامنة" Click="Stop_Click" IsEnabled="False"/><Button Content="مجلد النسخ المحلية" Click="Folder_Click"/><Button Content="إنشاء Token" Click="Token_Click"/></WrapPanel>
   <Border Grid.Row="1" Background="White" Padding="12" Margin="0,10"><TextBlock x:Name="StatusText" Text="جاهز للاتصال" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
   <TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White"/>
  </Grid>
  <TextBlock Grid.Row="3" Text="المزامنة بعد الحفظ وليست تحريرًا جماعيًا. عند التعارض تُحفظ نسختك محليًا ويتوقف الرفع." TextWrapping="Wrap" Foreground="#52616B" Margin="0,8,0,0"/>
 </Grid>
</Window>
